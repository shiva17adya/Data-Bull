# ---------------------------------------------------------------------------
# Person 4 module configuration
#
# The module runs fully offline with deterministic reasoning. Every variable
# below is OPTIONAL. Copy to .env and edit only what you need.
# ---------------------------------------------------------------------------

# --- LLM (optional) --------------------------------------------------------
# USE_LLM=false  -> deterministic reasoning only. No API key needed. Fast,
#                   free, and what the tests run against.
# USE_LLM=true   -> agents additionally ask Claude for narrative reasoning.
#                   If the call fails or times out, the deterministic result
#                   is used instead, so the demo cannot break because of it.
USE_LLM=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=900
LLM_TIMEOUT_S=20

# --- Orchestration ---------------------------------------------------------
# Per-agent hard timeout. A hung agent is marked failed and the rest proceed.
AGENT_TIMEOUT_S=25

# --- Synthesis weights (must reflect your demo narrative) ------------------
WEIGHT_TECHNICAL=0.35
WEIGHT_FUNDAMENTAL=0.40
WEIGHT_SENTIMENT=0.25

# --- Signal band edges (absolute weighted score) ---------------------------
STRONG_BAND=0.50
MODERATE_BAND=0.15

# --- Confidence penalties / caps -------------------------------------------
CONFLICT_PENALTY=0.30
MISSING_AGENT_CAP=0.65
LOW_QUALITY_CAP=0.50
NO_EVIDENCE_CAP=0.55
