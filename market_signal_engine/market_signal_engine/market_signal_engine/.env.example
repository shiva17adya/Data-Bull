# The default provider is fully simulated, so this module runs with NO API keys.
# Everything below is optional and only relevant once a live provider is added.

# Logging verbosity for the service.
LOG_LEVEL=INFO

# Number of historical candles the mock provider generates per symbol.
MARKET_HISTORY_LENGTH=120

# Reserved for a future live market data provider. Leave blank to stay on mock data.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
